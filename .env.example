# ── Database (PostgreSQL, e.g. brew services start postgresql@17) ─────────────
# Default when unset: postgres://<your-mac-user>@localhost:5432/dataminer
DATABASE_URL=postgres://timratig@localhost:5432/dataminer

# ── Eden AI gateway — THE ONLY LLM provider (chat, Firecrawl search + scrape) ─
# One key serves all models (openai/, anthropic/, google/, mistral/, meta/…).
# Can also be set in the UI: Globale Einstellungen, or per-case in case settings.
EDEN_API_KEY=your_edenai_api_key_here
# Firecrawl web features are US-only (api.edenai.run).

# Encrypts API keys at rest in PostgreSQL. REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_KEY_ENCRYPTION_KEY=

# ── Web search layers (used by discovery + column runs) ──────────────────────
SERPER_API_KEY=your_serper_api_key_here   # https://serper.dev — 2500 free queries
SERP_API_KEY=your_serpapi_key_here        # https://serpapi.com — 100 free searches/month (also powers Google Maps discovery)
BRAVE_API_KEY=your_brave_api_key_here     # https://brave.com/search/api — optional web search layer

# ── Scrapling sidecar (free Google bypass + Google Maps scraping) ────────────
# Run it:  npm run scrapling
SCRAPLING_URL=http://127.0.0.1:8001
SCRAPLING_TOKEN=dev-local-token

# ── Apollo.io (contacts lookup via the "Apollo Contacts" tool column) ────────
APOLLO_API_KEY=your_apollo_api_key_here   # Apollo → Settings → Integrations → API. Only the 0-credit SEARCH endpoint is used (no reveal).
APOLLO_TRANSPORT=mcp                      # "mcp" (community server via stdio) or "rest" (direct API). mcp auto-falls-back to rest.
# APOLLO_MCP_COMMAND=npx
# APOLLO_MCP_ARGS=-y @thevgergroup/apollo-io-mcp@latest
# APOLLO_MAX_LOOKUPS_RUN=500              # per-run budget guard for paid lookups
# APOLLO_MIN_INTERVAL_MS=500              # rate limiter between Apollo calls
